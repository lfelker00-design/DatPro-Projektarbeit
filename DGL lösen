# Numerisches Berechnen der Bewegungsgleichung

# Python Module importieren
import numpy as np  # Numpy importieren als "np"zum rechnen

import DatPro_Projekt_constants as const # Das Modul "DatPro_Projekt_constants" als "const" importieren
import DatPro_Projekt_Schub as schub # Das Modul "DatPro_Projekt_Schub" als "Schub" importieren
import DatPro_Projekt_Eagle as Eagle # Das Modul "DatPro_Projekt_Eagle" als "eagle" importieren


eagle = Eagle.Eagle(const.m_0, const.m_fuel0, const.v_g) # Definition von Eagle, damit die DGL auf die Klasse Eagle zugreifen kann

# Funktion der Bewegungsdifferentialgleichung für die Simulation der Bahn zur Ladung auf dem Mond
def dgl(s, t,a): 
    x, y, v_x, v_y = s # Statevektor
    r = np.sqrt(x**2 + y**2) # Abstand der Erde von der Sonne

    T_x, T_y = schub.schub(t, a) # Werte für T in x- und y-Richtung für den Schub

    T = np.sqrt(T_x**2 + T_y**2) # Definition von dem Schub T für die Definition von der Masse
    Masse_Eagle = eagle.Masse(T, t) # Definition der Masse von Eagle damit die DGL diese von der Klasse Eagle herausnehmen kann

    a_x = - ( const.GM_mond * x / r**3 ) - T_x / Masse_Eagle  # Berechnung der DGL für die x-Werte für die Beschleunigung
    a_y = - ( const.GM_mond * y / r**3 ) - T_y / Masse_Eagle  # Berechnung der DGL für die y-Werte für die Beschleunigung
    return [v_x, v_y, a_x, a_y] # Wiedergabe von Geschwindigkeit und Beschleunigung in x- und y-Richtung


