# Funktion der Kostenfunktion, welches a übergeben bekommt und die DGL und die Endgeschwindigkeit beinhaltet 
def Kostenfunktion(a): 
    z = DGL.scint.odeint(DGL.dgl, DGL.s0, DGL.t, args = (a,)) # Definition der Kostenfunktion "Kostenfkt" die gleich der DGL

    v_end_x = z[-1, 2] # Definiton von der Endgeschwindigkeit in x-Richtung
    v_end_y = z[-1, 3] # Definiton von der Endgeschwindigkeit in y-Richtung

    v_end = np.sqrt(v_end_x**2 + v_end_y**2) # Gesamte Endgeschwindigkeit ist die Wurzel aus der quadierte Summe von der Endgeschwindigkeit in x-Richtung und y-Richtung
    
    return v_end # Wiedergabe von der gesamten Endgeschwindigkeit


# Optimize für die richtigen a Werte
Startwerte = np.array([5000, 1000, 1000 ]) # Startwerte für die Werte von a für minimize
geeignete_a_Werte = minimize(Kostenfunktion, Startwerte, method='nelder-mead',  bounds=[(0, 40000), (0, 47000), (0, 47000)], options={'xatol': 1, 'disp': True}) # Die minimize() Funktion, die die Werte von a minimiert 


